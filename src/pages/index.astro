---
import ArticleRows from "#components/ArticleRows.astro";
import ContributionGraph from "#components/ContributionGraph.astro";
import ProjectTree from "#components/ProjectTree.astro";
import SkipLink from "#components/SkipLink.astro";
import Sponsors from "#components/Sponsors.astro";
import SpriteAvatar from "#components/SpriteAvatar.astro";
import Base from "#layouts/Base.astro";
import Panes from "#layouts/Panes.astro";
import { getCollection, getEntry } from "astro:content";
import "#styles/box.css";

const projects = [
	{
		name: "astro/",
		href: "https://astro.build",
		description: "The web framework for content-driven websites.",
	},
	{
		name: "lunaria/",
		href: "https://lunaria.dev",
		description: "A localization toolkit for open-source projects.",
	},
	{
		name: "craqueou/",
		href: "https://craqueou.com.br",
		description: "A daily football quiz to play with friends.",
	},
];

const articles = (await getCollection("articles"))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sponsors = (await getCollection("sponsors")).map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

const calendar = (await getEntry("contributions", "calendar"))?.data;
---

<Base
	description="Your friendly neighborhood open-source developer."
	ogId="home"
	ogAlt="Yan Thomas in pixel type beside a pixel-art avatar of a white cat in round sunglasses, over a year of GitHub contributions."
>
	<SkipLink href="#main" label="Skip to projects and articles" />
	<Panes home leftLabel="name">
		<Fragment slot="left">
			<div class="card">
				<SpriteAvatar />
				<div>
					<h1 id="name"><span>Yan</span>{" "}<span>Thomas</span></h1>
					{calendar && <ContributionGraph {...calendar} />}
				</div>
			</div>
			<div class="bio">
				<p>
					I'm an open-source developer from Brazil, working on
					tooling, documentation, and accessibility.
				</p>
				<p>
					You might know my work as a core maintainer of <a
						href="https://astro.build"
					>Astro</a> or as the author of <a href="https://lunaria.dev"
					>Lunaria</a>.
				</p>
				<p>
					I believe, stand, and work for a future where technology can
					make a more democratic, inclusive, and free world.
				</p>
			</div>
			<Sponsors sponsors={sponsors} />
			<aside class="box box--reach" aria-labelledby="reach-label">
				<div class="box-bar">
					<span class="box-label" id="reach-label" aria-hidden="true"
					>Reach out</span><i aria-hidden="true"></i><i
						aria-hidden="true"
					></i><i aria-hidden="true"></i>
				</div>
				<div class="box-body">
					<p>
						If you’re working on something I could help with, my
						inbox is always open at&nbsp;<a
							href="mailto:yanthomas.b@gmail.com"
						>yanthomas.b@gmail.com</a>.
					</p>
				</div>
			</aside>
		</Fragment>

		<section aria-labelledby="projects">
			<h2 id="projects">projects/</h2>
			<ProjectTree projects={projects} />
		</section>

		<section aria-labelledby="articles">
			<h2 id="articles">articles/</h2>
			<ArticleRows articles={articles} />
		</section>
	</Panes>
</Base>

<style>
.card {
	display: flex;
	align-items: flex-end;
	gap: var(--space-5);
}

.card > div {
	display: flex;
	flex-direction: column;
	gap: 10px;
	min-width: 0;
}

h1 {
	font-family: var(--font-pixel);
	font-weight: 400;
	font-size: 90px;
	line-height: 0.6667;
	letter-spacing: 0;
	margin: 0;
	white-space: nowrap;
	text-transform: uppercase;
}

h1 > span {
	display: block;
}

h2 {
	font-family: var(--font-pixel);
	font-weight: 400;
	font-size: 1.875rem;
	line-height: 1;
	margin: 0 0 14px;
	display: flex;
	align-items: center;
	gap: var(--space-4);
}

