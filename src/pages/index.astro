		0 0 / 120px 8px no-repeat;
}

.bio {
	display: flex;
	flex-direction: column;
	gap: 14px;
	max-width: 30em;
	margin: 8px 0 0;
	font-family: var(--font-read);
	font-size: 1.125rem;
	line-height: 1.6;
	color: var(--text);
}

.bio p {
	margin: 0;
}

.bio p + p:last-child {
	color: var(--dim);
}

@media (max-width: 1300px) {
	h1 {
		font-size: 60px;
	}
}

@media (max-width: 1300px) and (min-width: 1001px), (max-width: 600px) {
	.card {
		--avatar: 144px;
		flex-wrap: wrap;
		row-gap: 14px;
	}

	.card > div {
		display: contents;
	}

	.card :global(figure) {
		flex: 1 0 100%;
		order: 3;
	}

	.card :global(figure svg) {
		max-width: 422px;
	}
}

@media (max-width: 1000px) {
	h1 {
		font-size: 90px;
	}
}

@media (max-width: 600px) {
	h1 {
		font-size: 60px;
	}

	.card {
		gap: var(--space-4);
	}

	@supports (hyphenate-limit-chars: 8 4 3) {
		.bio {
			hyphens: auto;
			hyphenate-limit-chars: 8 4 3;
		}
	}
}

@media (min-width: 1001px) and (max-height: 800px) {
	.bio {
		gap: 8px;
		margin-top: 0;
		font-size: 1.0625rem;
		line-height: 1.5;
	}
}

@media (min-width: 1001px) {
	@container (max-width: 400px) {
		.bio {
			gap: 8px;
			margin-top: 0;
			font-size: 1.0625rem;
			line-height: 1.5;
		}
	}
}
</style>
