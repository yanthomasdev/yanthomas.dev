---
interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a href={href}>{label}</a>

<style>
a {
	position: absolute;
	left: 16px;
	top: -100px;
	z-index: 20;
	padding: 8px 12px;
	background: var(--fg);
	color: var(--bg);
	text-decoration: none;
}

a:focus {
	top: 12px;
}

@media print {
	a {
		display: none;
	}
}
</style>
