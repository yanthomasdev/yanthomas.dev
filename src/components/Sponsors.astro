---
import type { CollectionEntry } from "astro:content";

interface Props {
	sponsors: CollectionEntry<"sponsors">["data"][];
}

const { sponsors } = Astro.props;
---

{sponsors.length > 0 && (
	<section class="sponsors" aria-labelledby="sponsors-label">
		<h2 id="sponsors-label">Sponsored by</h2>
		<ul>
			{sponsors.map((s) => (
				<li>
					<a
						href={`https://github.com/${s.login}`}
						title={`@${s.login}`}
					>
						<img
							src={s.avatar}
							alt={`@${s.login}`}
							width="48"
							height="48"
						/>
					</a>
				</li>
			))}
			<li>
				<a
					class="join"
					href="https://github.com/sponsors/yanthomasdev"
					title="Sponsor me on GitHub"
					aria-label="Sponsor me on GitHub"
				>
					<span aria-hidden="true">+</span>
				</a>
			</li>
		</ul>
	</section>
)}

<style>
section {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 10px var(--space-4);
	margin-block: var(--space-2) var(--space-4);
}

h2 {
	margin: 0;
	font: inherit;
	font-size: 0.8125rem;
	color: var(--dim);
}

ul {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin: 0;
	padding: 0;
	list-style: none;
}

a {
	position: relative;
	display: block;
	width: 48px;
	height: 48px;
}

img {
	display: block;
	width: 48px;
	height: 48px;
	image-rendering: pixelated;
}

.join {
	display: grid;
	place-items: center;
	color: var(--dim);
	text-decoration: none;
	font-size: 1.125rem;
	line-height: 1;
}

.join::before {
	content: "";
	position: absolute;
	inset: 0;
	padding: 2px;
	background: currentColor;
	-webkit-mask:
		var(--dither-50) 0 0 / 8px 8px,
		linear-gradient(#000 0 0) content-box,
		linear-gradient(#000 0 0);
	-webkit-mask-composite: source-in, xor;
	mask:
		var(--dither-50) 0 0 / 8px 8px,
		linear-gradient(#000 0 0) content-box,
		linear-gradient(#000 0 0);
	mask-composite: intersect, exclude;
}

@media (min-width: 1001px) and (max-height: 800px) {
	section {
		margin-block: 4px var(--space-3);
	}
}

@media (min-width: 1001px) {
	@container (max-width: 400px) {
		a, img {
			width: 40px;
			height: 40px;
		}
	}
}

@media (hover: hover) and (pointer: fine) {
	a:hover {
		background: none;
	}

	a:hover img {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}

	.join:hover {
		color: var(--acc2);
	}
}

@media (forced-colors: active) {
	.join {
		outline: 1px dashed CanvasText;
		outline-offset: -1px;
	}
}
</style>
